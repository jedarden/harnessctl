{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jedarden/harnessctl/blob/main/docs/schemas/harnessctl-status-v1.schema.json",
  "title": "harnessctl status v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "profile",
    "permission_mode",
    "launcher_update_policy",
    "agent_update_policy",
    "agent",
    "agent_source",
    "context",
    "workdir",
    "config_path",
    "profile_path",
    "launcher_path",
    "update_url",
    "installed"
  ],
  "properties": {
    "schema": { "const": "harnessctl-status-v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": { "enum": ["safe", "fleet", "compatibility"] },
    "permission_mode": { "enum": ["default", "bypass"] },
    "launcher_update_policy": { "enum": ["always", "daily", "never"] },
    "agent_update_policy": { "enum": ["always", "daily", "missing-only", "never"] },
    "agent": { "type": ["string", "null"], "enum": ["claude", "codex", null] },
    "agent_source": { "enum": ["config", "interactive-prompt", "noninteractive-default"] },
    "context": { "enum": ["bare", "tmux", "herdr"] },
    "workdir": { "type": "string" },
    "config_path": { "type": "string" },
    "profile_path": { "type": "string" },
    "launcher_path": { "type": "string" },
    "update_url": { "type": "string" },
    "installed": {
      "type": "object",
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "type": "boolean" },
        "codex": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "required": ["inventory", "capacity"],
      "properties": {
        "inventory": {
          "type": "object",
          "required": ["complete", "counts", "agents"],
          "properties": {
            "complete": { "type": "boolean" },
            "counts": {
              "type": "object",
              "required": ["claude", "codex", "total"],
              "properties": {
                "claude": { "type": "integer", "minimum": 0 },
                "codex": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pid", "uid", "agent"],
                "properties": {
                  "pid": { "type": "integer", "minimum": 1 },
                  "uid": { "type": "string" },
                  "agent": { "enum": ["claude", "codex"] },
                  "session_id": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "capacity": {
          "type": "object",
          "required": ["ready", "reason", "cpu_millicores", "cpu_load_millicores", "memory_available_bytes"],
          "properties": {
            "ready": { "type": "boolean" },
            "reason": { "enum": ["ready", "disabled", "cpu", "memory", "metrics-unavailable", "inventory-unavailable"] },
            "cpu_millicores": { "type": "integer", "minimum": 0 },
            "cpu_load_millicores": { "type": "integer", "minimum": 0 },
            "memory_available_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
