#!/usr/bin/env bash
set -Eeuo pipefail

# Generated by scripts/release.py; trust anchors come from start.sh.
@TRUST_BLOCK@
UPDATE_REPO_URL="$REPO_URL"
@VERIFY_FUNCTIONS@

script_path="${START_SH_INSTALL_PATH:-$HOME/start.sh}"
bin_dir="${START_SH_BIN_DIR:-$HOME/.local/bin}"
profile_path="${START_SH_PROFILE_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/harnessctl/profile}"
install_profile="${START_SH_INSTALL_PROFILE:-auto}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --script-path|--bin-dir|--source|--profile|--profile-path)
            [[ $# -ge 2 && -n "$2" ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
            case "$1" in
                --script-path) script_path="$2" ;;
                --bin-dir) bin_dir="$2" ;;
                --source) UPDATE_REPO_URL="${2%/}" ;;
                --profile) install_profile="$2" ;;
                --profile-path) profile_path="$2" ;;
            esac
            shift 2
            ;;
        --version|-v) echo "harnessctl installer v$START_SH_VERSION"; exit 0 ;;
        --help|-h)
            cat <<'HELP'
Usage: bash install.sh [OPTIONS]

Authenticate and install the signed harnessctl launcher.

Options:
  --script-path PATH  Launcher destination (default: ~/start.sh)
  --bin-dir DIR       Directory for the start symlink (default: ~/.local/bin)
  --source URL        Signed release root containing the manifest and artifacts
  --profile PROFILE   Write safe or fleet; preserve leaves existing policy alone
                      (default: safe for a fresh install, preserve for upgrades)
  --profile-path PATH Profile data file (default: ~/.config/harnessctl/profile)
  --version, -v       Print the installer version and exit
  --help, -h          Show this help and exit

Environment equivalents:
  START_SH_INSTALL_PATH  Launcher destination
  START_SH_BIN_DIR       Directory for the start symlink
  START_SH_INSTALL_PROFILE  safe, fleet, or preserve
  START_SH_PROFILE_PATH     Profile data-file path
HELP
            exit 0
            ;;
        *) echo "Error: unknown option: $1" >&2; exit 2 ;;
    esac
done
case "$install_profile" in
    auto|safe|fleet|preserve) ;;
    *) echo "Error: --profile must be safe, fleet, or preserve" >&2; exit 2 ;;
esac
for dependency in curl openssl sha256sum base64 bash; do
    command -v "$dependency" >/dev/null 2>&1 || { echo "Error: $dependency is required" >&2; exit 1; }
done
openssl version >/dev/null 2>&1 || {
    echo 'Error: openssl exists but cannot run; check its shared libraries' >&2
    exit 1
}

mkdir -p "$(dirname "$script_path")" "$bin_dir"
script_path="$(readlink -m "$script_path")"
profile_path="$(readlink -m "$profile_path")"
bin_dir="$(cd "$bin_dir" && pwd -P)"
link="$bin_dir/start"
had_launcher=false
[[ ! -f "$script_path" ]] || had_launcher=true
if [[ (-e "$link" || -L "$link") && "$(readlink -f "$link" 2>/dev/null || true)" != "$script_path" ]]; then
    echo "Error: $link already belongs to another command" >&2
    exit 1
fi
if command -v git >/dev/null 2>&1 &&
    git -C "$(dirname "$script_path")" ls-files --error-unmatch "$(basename "$script_path")" >/dev/null 2>&1; then
    echo 'Error: install to a deployed location outside tracked source files' >&2
    exit 1
fi
work=$(mktemp -d "${script_path}.install.XXXXXX")
trap 'rm -rf "$work"' EXIT
version=$(verify_artifact_manifest "$work") || { echo 'Error: release signature verification failed' >&2; exit 1; }
curl -fsSL --connect-timeout 5 --max-time 30 "$UPDATE_REPO_URL/start.sh" > "$work/start.sh"
verify_artifact_file "$work/$ARTIFACT_MANIFEST_FILE" start.sh "$work/start.sh" || {
    echo 'Error: launcher does not match the signed release' >&2; exit 1;
}
bash -n "$work/start.sh"
# Refuse downgrades, including when installing a pinned older release.
if [[ -f "$script_path" ]]; then
    installed=$(sed -n 's/^START_SH_VERSION="\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)"$/\1/p' "$script_path")
    if [[ -n "$installed" && "$installed" != "$version" &&
          "$(printf '%s\n%s\n' "$installed" "$version" | sort -V | head -1)" == "$version" ]]; then
        echo "Error: refusing to replace installed $installed with older $version" >&2
        exit 1
    fi
fi
chmod 0755 "$work/start.sh"
mv -f "$work/start.sh" "$script_path"
[[ -L "$link" ]] || ln -s "$script_path" "$link"

profile_to_write=""
case "$install_profile" in
    safe|fleet) profile_to_write=$install_profile ;;
    auto)
        if ! $had_launcher && [[ ! -e "$profile_path" ]]; then
            profile_to_write=safe
        fi
        ;;
esac
if [[ -n "$profile_to_write" ]]; then
    mkdir -p "$(dirname "$profile_path")"
    profile_tmp=$(mktemp "${profile_path}.tmp.XXXXXX")
    printf '%s\n' "$profile_to_write" > "$profile_tmp"
    chmod 0600 "$profile_tmp"
    mv -f "$profile_tmp" "$profile_path"
    echo "Configured $profile_to_write profile: $profile_path"
elif [[ "$install_profile" == preserve || "$install_profile" == auto ]]; then
    echo "Preserved existing launcher policy (use --profile safe or --profile fleet to change it)."
fi
echo "Installed start v$version: $link -> $script_path"
echo 'Run start status, start doctor --offline, start claude, or start codex.'
case ":$PATH:" in *":$bin_dir:"*) ;; *) printf 'Add to your shell PATH: export PATH=%q:$PATH\n' "$bin_dir" ;; esac
