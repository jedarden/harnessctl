#!/usr/bin/env bash
set -Eeuo pipefail

# Generated by scripts/release.py; trust anchors come from start.sh.
@TRUST_BLOCK@
UPDATE_REPO_URL="$REPO_URL"
@VERIFY_FUNCTIONS@

script_path="${START_SH_INSTALL_PATH:-$HOME/start.sh}"
bin_dir="${START_SH_BIN_DIR:-$HOME/.local/bin}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --script-path|--bin-dir|--source)
            [[ $# -ge 2 && -n "$2" ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
            case "$1" in
                --script-path) script_path="$2" ;;
                --bin-dir) bin_dir="$2" ;;
                --source) UPDATE_REPO_URL="${2%/}" ;;
            esac
            shift 2
            ;;
        --version) echo "harnessctl installer v$START_SH_VERSION"; exit 0 ;;
        --help|-h)
            echo 'Usage: bash install.sh [--script-path PATH] [--bin-dir DIR] [--source RELEASE-URL]'
            exit 0
            ;;
        *) echo "Error: unknown option: $1" >&2; exit 2 ;;
    esac
done
for dependency in curl openssl sha256sum base64 bash; do
    command -v "$dependency" >/dev/null 2>&1 || { echo "Error: $dependency is required" >&2; exit 1; }
done

mkdir -p "$(dirname "$script_path")" "$bin_dir"
script_path="$(readlink -m "$script_path")"
bin_dir="$(cd "$bin_dir" && pwd -P)"
link="$bin_dir/start"
if [[ (-e "$link" || -L "$link") && "$(readlink -f "$link" 2>/dev/null || true)" != "$script_path" ]]; then
    echo "Error: $link already belongs to another command" >&2
    exit 1
fi
if command -v git >/dev/null 2>&1 &&
    git -C "$(dirname "$script_path")" ls-files --error-unmatch "$(basename "$script_path")" >/dev/null 2>&1; then
    echo 'Error: install to a deployed location outside tracked source files' >&2
    exit 1
fi
work=$(mktemp -d "${script_path}.install.XXXXXX")
trap 'rm -rf "$work"' EXIT
version=$(verify_artifact_manifest "$work") || { echo 'Error: release signature verification failed' >&2; exit 1; }
curl -fsSL --connect-timeout 5 --max-time 30 "$UPDATE_REPO_URL/start.sh" > "$work/start.sh"
verify_artifact_file "$work/$ARTIFACT_MANIFEST_FILE" start.sh "$work/start.sh" || {
    echo 'Error: launcher does not match the signed release' >&2; exit 1;
}
bash -n "$work/start.sh"
# Refuse downgrades, including when installing a pinned older release.
if [[ -f "$script_path" ]]; then
    installed=$(sed -n 's/^START_SH_VERSION="\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)"$/\1/p' "$script_path")
    if [[ -n "$installed" && "$installed" != "$version" &&
          "$(printf '%s\n%s\n' "$installed" "$version" | sort -V | head -1)" == "$version" ]]; then
        echo "Error: refusing to replace installed $installed with older $version" >&2
        exit 1
    fi
fi
chmod 0755 "$work/start.sh"
mv -f "$work/start.sh" "$script_path"
[[ -L "$link" ]] || ln -s "$script_path" "$link"
echo "Installed start v$version: $link -> $script_path"
echo 'Run start claude, start codex, or start update.'
case ":$PATH:" in *":$bin_dir:"*) ;; *) printf 'Add to your shell PATH: export PATH=%q:$PATH\n' "$bin_dir" ;; esac
